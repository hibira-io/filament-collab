{
    "name": "hibira-io/filament-collab",
    "description": "Google Docs style collaborative rich text editing for Filament: several people edit the same field at once, with live cursors, synced with Yjs over Hibira WebSockets",
    "keywords": [
        "filament",
        "filamentphp",
        "laravel",
        "rich-text",
        "editor",
        "tiptap",
        "yjs",
        "crdt",
        "collaboration",
        "multiplayer",
        "realtime",
        "hibira"
    ],
    "homepage": "https://hibira.io",
    "license": "MIT",
    "authors": [
        {
            "name": "Hibira",
            "homepage": "https://hibira.io"
        }
    ],
    "support": {
        "issues": "https://github.com/hibira-io/filament-collab/issues",
        "docs": "https://github.com/hibira-io/filament-collab#readme",
        "email": "support@hibira.io"
    },
    "require": {
        "php": "^8.1",
        "filament/filament": "^3.0|^4.0|^5.0",
        "hibira-io/filament": "^0.2",
        "hibira-io/laravel": "^0.1|^0.2",
        "pusher/pusher-php-server": "^7.2"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hibira\\FilamentCollab\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hibira\\FilamentCollab\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hibira\\FilamentCollab\\CollabServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
